{
  "info": {
    "name": "PersonalHub API",
    "description": "Import the example environment and set apiKey locally. Run Sync requests only after setting runSync=true. Notion folder requires NOTION_ENABLED=true. Empty task/run detail IDs are skipped. No upstream token belongs in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "runSync",
      "value": "false",
      "type": "string"
    },
    {
      "key": "githubRunId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notionRunId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notionTaskId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Request ID header is a UUID\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/); });",
          "if (pm.response.code >= 400) {",
          "  pm.test(\"Problem Details content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); });",
          "  pm.test(\"Problem Details fields\", function () {",
          "    const problem = pm.response.json();",
          "    [\"title\", \"status\", \"detail\", \"instance\", \"code\", \"requestId\"].forEach(function (field) { pm.expect(problem).to.have.property(field); });",
          "    pm.expect(problem.status).to.eql(pm.response.code);",
          "    pm.expect(problem.requestId).to.eql(pm.response.headers.get(\"X-Request-ID\"));",
          "    if (problem.type !== undefined) { pm.expect(problem.type).to.eql(\"about:blank\"); }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Read API",
      "item": [
        {
          "name": "Health (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/openapi.json",
            "description": ""
