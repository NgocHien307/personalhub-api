          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"OpenAPI 3.1\", function () { pm.expect(pm.response.json().openapi).to.eql(\"3.1.0\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dashboard/overview?days=30",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Overview totals and status groups\", function () { const x = pm.response.json(); pm.expect(x.days).to.eql(30); pm.expect(x.notion.enabled).to.be.a(\"boolean\"); pm.expect(x.notion.archivedTasks).to.be.at.least(0); pm.expect(x.notion.tasksByStatus.reduce(function (n, s) { return n + s.count; }, 0)).to.eql(x.notion.activeTasks); });"
                ]
              }
            }
          ]
        },
