    {
      "name": "Sync (opt in)",
      "item": [
        {
          "name": "Trigger GitHub sync (202)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/sync/github",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
                  "pm.collectionVariables.set(\"githubRunId\", pm.response.json().id);",
                  "pm.test(\"Run Location header\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/sync/runs/\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runSync\") !== \"true\") { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Trigger Notion incremental sync",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notion/sync?full=false",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"notionRunId\", pm.response.json().id);",
                  "pm.test(\"Sync completed\", function () { pm.expect(pm.response.json().status).to.eql(\"SUCCESS\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runSync\") !== \"true\") { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Trigger Notion full sync",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notion/sync?full=true",
            "description": ""
