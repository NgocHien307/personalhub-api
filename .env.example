# Copy to .env (do not commit .env). Use a long random API key.
POSTGRES_PASSWORD=
POSTGRES_DB=personalhub
GITHUB_USERNAME=octocat
GITHUB_TOKEN=
PERSONALHUB_API_KEY=
# Only controls the GitHub scheduler; manual POST sync still works when false.
SYNC_ENABLED=false
SYNC_MAX_REPOSITORIES=10
# GitHub GET retry and startup recovery are automatic; run one API instance per database.

# Fill locally; NOTION_DATA_SOURCE_ID is a UUID with hyphens, not a database ID.
NOTION_ENABLED=false
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2025-09-03
NOTION_TITLE_PROPERTY=Name
NOTION_STATUS_PROPERTY=Status
NOTION_DUE_PROPERTY=Due
NOTION_MAX_PAGES=100
NOTION_OVERLAP_MINUTES=5
NOTION_SYNC_ENABLED=false
NOTION_SYNC_FIXED_DELAY_MS=1800000
NOTION_SYNC_INITIAL_DELAY_MS=30000

# Production: compose.yaml + compose.production.yaml (see docs/OPERATIONS_VI.md).
# A public DNS name pointing to your server; localhost uses a local CA for testing.
SITE_ADDRESS=localhost
